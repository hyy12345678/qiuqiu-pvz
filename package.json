{
  "name": "qiuqiu-pvz",
  "version": "0.1.0",
  "private": true,
  "description": "球球的植物大战僵尸 · 网页同人复刻版（模块化源码头 + 单文件离线产物）",
  "scripts": {
    "build": "node scripts/build.js",
    "build:min": "node scripts/build.js --minify",
    "dev": "node scripts/dev.js",
    "parity": "node scripts/check-parity.js",
    "parity:legacy": "node scripts/check-parity.js --legacy",
    "parity:dist": "node scripts/check-parity.js --dist",
    "parity:dist:min": "node scripts/check-parity.js --dist --minify --file=dist/植物大战僵尸-网页版.min.html",
    "parity:rebase": "npm test && node scripts/check-parity.js --rebase --yes",
    "parity:rebase:dry": "node scripts/check-parity.js --rebase",
    "fingerprint": "node scripts/check-fingerprint.js",
    "fingerprint:update": "npm test && node scripts/check-fingerprint.js --update --yes",
    "fingerprint:update:dry": "node scripts/check-fingerprint.js --update",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "test:browser:update": "npm test && UPDATE_TRACE=1 node --test tests/browser/render-baseline.test.mjs",
    "test:smoke": "node headless_test.js src/main.js",
    "dist:fresh": "git diff --exit-code -- dist/",
    "verify": "npm run parity && npm run fingerprint && npm run test && npm run parity:dist && npm run build && npm run test:smoke && npm run test:browser"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.64.1"
  }
}
